{"name": "雙十親子遊2026", "script": "// Variables used by Scriptable.\n// icon-color: teal; icon-glyph: route;\nconst EVENTS = [{\"id\": \"d10-0800\", \"at\": \"2026-10-10T08:00:00+08:00\", \"title\": \"出發 → 東眼山餐廳停車場\", \"body\": \"預計09:45集合。預設萬大國小出發，可修改；實際車程依Google Maps路況。\", \"destination\": \"東眼山餐廳停車場\", \"mode\": \"driving\", \"origin\": \"萬大國小\", \"kind\": \"navigation\", \"url\": \"https://www.google.com/maps/dir/?api=1&destination=24.8282211%2C121.40986459999999&travelmode=driving&origin=%E8%87%BA%E5%8C%97%E5%B8%82%E8%90%AC%E8%8F%AF%E5%8D%80%E8%90%AC%E5%A4%A7%E5%9C%8B%E6%B0%91%E5%B0%8F%E5%AD%B8&dir_action=navigate\"}, {\"id\": \"d10-0945\", \"at\": \"2026-10-10T09:45:00+08:00\", \"title\": \"東眼山集合／森林散步\", \"body\": \"09:45–12:00。過收費口右轉，餐廳停車場集合。原行程費用：成人100元；65歲以上、6歲以下10元；12歲以下50元；停車100元。費用依現場公告。\", \"destination\": \"東眼山餐廳停車場\", \"mode\": \"driving\", \"origin\": null, \"kind\": \"reminder\", \"url\": \"https://www.google.com/maps/dir/?api=1&destination=24.8282211%2C121.40986459999999&travelmode=driving&dir_action=navigate\"}, {\"id\": \"d10-1200\", \"at\": \"2026-10-10T12:00:00+08:00\", \"title\": \"離開東眼山 → 泉頭午餐\", \"body\": \"12:30訂位16位，午餐至13:30。羅浮里147-2號；車停店門馬路旁白線內，依現場標示。\", \"destination\": \"泉頭泰雅創意料理\", \"mode\": \"driving\", \"origin\": null, \"kind\": \"navigation\", \"url\": \"https://www.google.com/maps/dir/?api=1&destination=24.797705%2C121.360962&travelmode=driving&dir_action=navigate\"}, {\"id\": \"d10-1230\", \"at\": \"2026-10-10T12:30:00+08:00\", \"title\": \"泉頭泰雅創意料理午餐\", \"body\": \"已訂16位，12:30–13:30。\", \"destination\": \"泉頭泰雅創意料理\", \"mode\": \"driving\", \"origin\": null, \"kind\": \"reminder\", \"url\": \"https://www.google.com/maps/dir/?api=1&destination=24.797705%2C121.360962&travelmode=driving&dir_action=navigate\"}, {\"id\": \"d10-1330\", \"at\": \"2026-10-10T13:30:00+08:00\", \"title\": \"離開泉頭 → 基拉耳山莊\", \"body\": \"14:00抵達，泡茶、走步道；16:00入住；18:00民宿內晚餐。\", \"destination\": \"基拉耳山莊\", \"mode\": \"driving\", \"origin\": null, \"kind\": \"navigation\", \"url\": \"https://www.google.com/maps/dir/?api=1&destination=24.8052836%2C121.3474821&travelmode=driving&dir_action=navigate\"}, {\"id\": \"d10-1400\", \"at\": \"2026-10-10T14:00:00+08:00\", \"title\": \"基拉耳山莊泡茶、走步道\", \"body\": \"桃園市復興區溪口路16巷29號。\", \"destination\": \"基拉耳山莊\", \"mode\": \"driving\", \"origin\": null, \"kind\": \"reminder\", \"url\": \"https://www.google.com/maps/dir/?api=1&destination=24.8052836%2C121.3474821&travelmode=driving&dir_action=navigate\"}, {\"id\": \"d10-1600\", \"at\": \"2026-10-10T16:00:00+08:00\", \"title\": \"基拉耳山莊 Check in\", \"body\": \"入住提醒；已在山莊可直接略過。\", \"destination\": \"基拉耳山莊\", \"mode\": \"driving\", \"origin\": null, \"kind\": \"reminder\", \"url\": \"https://www.google.com/maps/dir/?api=1&destination=24.8052836%2C121.3474821&travelmode=driving&dir_action=navigate\"}, {\"id\": \"d10-1800\", \"at\": \"2026-10-10T18:00:00+08:00\", \"title\": \"民宿內晚餐\", \"body\": \"在基拉耳山莊用餐。\", \"destination\": \"基拉耳山莊\", \"mode\": \"driving\", \"origin\": null, \"kind\": \"reminder\", \"url\": \"https://www.google.com/maps/dir/?api=1&destination=24.8052836%2C121.3474821&travelmode=driving&dir_action=navigate\"}, {\"id\": \"d11-1030\", \"at\": \"2026-10-11T10:30:00+08:00\", \"title\": \"Check out → 小烏來停車場\", \"body\": \"10:30–11:00前往及停車。每次100元，依現場公告。備用：小烏來金地收費停車場。\", \"destination\": \"小烏來停車場\", \"mode\": \"driving\", \"origin\": null, \"kind\": \"navigation\", \"url\": \"https://www.google.com/maps/dir/?api=1&destination=24.7910808%2C121.3781514&travelmode=driving&dir_action=navigate\"}, {\"id\": \"d11-1100\", \"at\": \"2026-10-11T11:00:00+08:00\", \"title\": \"分組：4人買票／12人拍照\", \"body\": \"4人至天空步道售票處買11:30梯次；12人先去寰宇平台拍照；11:25於天空步道集合。若買不到11:30，改水岸綠廊看瀑布。點通知步行至天空步道。\", \"destination\": \"小烏來天空步道\", \"mode\": \"walking\", \"origin\": null, \"kind\": \"navigation\", \"url\": \"https://www.google.com/maps/dir/?api=1&destination=24.790326399999998%2C121.3754843&travelmode=walking&dir_action=navigate\"}, {\"id\": \"d11-1125\", \"at\": \"2026-10-11T11:25:00+08:00\", \"title\": \"天空步道集合\", \"body\": \"16人集合，準備11:30梯次；是否入場依現場購票結果。\", \"destination\": \"小烏來天空步道\", \"mode\": \"walking\", \"origin\": null, \"kind\": \"reminder\", \"url\": \"https://www.google.com/maps/dir/?api=1&destination=24.790326399999998%2C121.3754843&travelmode=walking&dir_action=navigate\"}, {\"id\": \"d11-1130\", \"at\": \"2026-10-11T11:30:00+08:00\", \"title\": \"天空步道預定梯次\", \"body\": \"此為預定購票梯次，尚未購票，依現場可購梯次安排。\", \"destination\": \"小烏來天空步道\", \"mode\": \"walking\", \"origin\": null, \"kind\": \"reminder\", \"url\": \"https://www.google.com/maps/dir/?api=1&destination=24.790326399999998%2C121.3754843&travelmode=walking&dir_action=navigate\"}, {\"id\": \"d11-1200\", \"at\": \"2026-10-11T12:00:00+08:00\", \"title\": \"走回小烏來停車場\", \"body\": \"原行程12:00開始走回停車場；預計12:30離開。\", \"destination\": \"小烏來停車場\", \"mode\": \"walking\", \"origin\": null, \"kind\": \"navigation\", \"url\": \"https://www.google.com/maps/dir/?api=1&destination=24.7910808%2C121.3781514&travelmode=walking&dir_action=navigate\"}, {\"id\": \"d11-1230\", \"at\": \"2026-10-11T12:30:00+08:00\", \"title\": \"離開小烏來 → 山月茶屋\", \"body\": \"13:00已訂16位，午餐至14:30。桃園市復興區枕頭山7鄰11之5號。\", \"destination\": \"景美山林茶園&山月茶屋\", \"mode\": \"driving\", \"origin\": null, \"kind\": \"navigation\", \"url\": \"https://www.google.com/maps/dir/?api=1&destination=24.8197542%2C121.3399656&travelmode=driving&dir_action=navigate\"}, {\"id\": \"d11-1300\", \"at\": \"2026-10-11T13:00:00+08:00\", \"title\": \"山月茶屋午餐\", \"body\": \"已訂位16位，13:00–14:30。\", \"destination\": \"景美山林茶園&山月茶屋\", \"mode\": \"driving\", \"origin\": null, \"kind\": \"reminder\", \"url\": \"https://www.google.com/maps/dir/?api=1&destination=24.8197542%2C121.3399656&travelmode=driving&dir_action=navigate\"}, {\"id\": \"d11-1430\", \"at\": \"2026-10-11T14:30:00+08:00\", \"title\": \"行程結束 → 萬大國小\", \"body\": \"返程目的地：臺北市萬華區萬大國小。\", \"destination\": \"萬大國小\", \"mode\": \"driving\", \"origin\": null, \"kind\": \"navigation\", \"url\": \"https://www.google.com/maps/dir/?api=1&destination=%E8%87%BA%E5%8C%97%E5%B8%82%E8%90%AC%E8%8F%AF%E5%8D%80%E8%90%AC%E5%A4%A7%E5%9C%8B%E6%B0%91%E5%B0%8F%E5%AD%B8&travelmode=driving&dir_action=navigate\"}];\nconst PREFIX = 'double-ten-2026-';\nconst key = PREFIX + 'origin';\nconst defaultOrigin = \"臺北市萬華區萬大國民小學\";\nconst defaultHome = \"臺北市萬華區萬大國民小學\";\nconst homeKey = PREFIX + 'home';\nconst signatureKey = PREFIX + 'import-settings';\nconst signature = JSON.stringify([defaultOrigin, defaultHome]);\nconst useSaved = Keychain.contains(signatureKey) && Keychain.get(signatureKey) === signature;\nlet origin = useSaved && Keychain.contains(key) ? Keychain.get(key) : defaultOrigin;\nlet home = useSaved && Keychain.contains(homeKey) ? Keychain.get(homeKey) : defaultHome;\nconst menu = new Alert(); menu.title='雙十親子遊 2026';\nmenu.message='一次排入兩天通知。導航使用 Google Maps；時間均為台灣時間。';\nmenu.addAction('安裝／更新全部通知'); menu.addAction('測試：10秒後通知'); menu.addDestructiveAction('取消本行程通知'); menu.addCancelAction('離開');\nconst choice = await menu.presentSheet();\nif(choice === 0) {\n const form = new Alert(); form.title='出發與回程地點'; form.message='修改後會重排本行程通知。'; form.addTextField('第一天出發地',origin); form.addTextField('回程目的地',home); form.addAction('排入通知'); form.addCancelAction('取消');\n if(await form.presentAlert()===0) {\n  origin=form.textFieldValue(0).trim(); home=form.textFieldValue(1).trim(); if(!origin || !home)throw new Error('出發地與回程目的地不可空白');\n  Keychain.set(key,origin); Keychain.set(homeKey,home); Keychain.set(signatureKey,signature);\n  const pending=await Notification.allPending();\n  await Notification.removePending(pending.filter(n=>n.identifier.startsWith(PREFIX)).map(n=>n.identifier));\n  let count=0;\n  for(const e of EVENTS) {\n   const date=new Date(e.at); if(date<=new Date())continue;\n   let url=e.url;\n   if(e.id==='d10-0800')url=url.replace(/([?&]origin=)[^&]*/, '$1'+encodeURIComponent(origin));\n   if(e.id==='d11-1430')url=url.replace(/([?&]destination=)[^&]*/, '$1'+encodeURIComponent(home));\n   const n=new Notification(); n.identifier=PREFIX+e.id; n.title=e.id==='d11-1430'?'行程結束 → '+home:e.title; n.body=(e.id==='d11-1430'?'返程目的地：'+home:e.id==='d10-0800'?'出發地：'+origin+'；預計09:45於東眼山餐廳停車場集合。':e.body)+'\\n點此開啟 Google Maps'; n.sound='default'; n.openURL=url; n.setTriggerDate(date); await n.schedule(); count++;\n  }\n  const done=new Alert();done.title='已排入 '+count+' 則未來通知';done.message='請允許 Scriptable 通知，並執行測試確認點擊可開 Google Maps。';done.addAction('完成');await done.presentAlert();\n }\n} else if(choice===1) {\n const n=new Notification();n.identifier=PREFIX+'test';n.title='測試：開啟東眼山導航';n.body='點此應開啟 Google Maps。測試不影響正式行程。';n.openURL=EVENTS[0].url.replace(/([?&]origin=)[^&]*/, '$1'+encodeURIComponent(origin));n.sound='default';n.setTriggerDate(new Date(Date.now()+10000));await n.schedule();\n} else if(choice===2) {\n const pending=await Notification.allPending(); await Notification.removePending(pending.filter(n=>n.identifier.startsWith(PREFIX)).map(n=>n.identifier));\n const delivered=await Notification.allDelivered();await Notification.removeDelivered(delivered.filter(n=>n.identifier.startsWith(PREFIX)).map(n=>n.identifier));\n}\nScript.complete();\n", "icon": {"color": "teal", "glyph": "route"}, "always_run_in_app": true}